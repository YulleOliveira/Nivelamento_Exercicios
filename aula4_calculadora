print('''  
      =============================
      |        CALCULADORA        |
      |                           |
      | [1] Soma                  |
      | [2] Subtração             |
      | [3] Multiplicação         |
      | [4] Divisão               |
      | [5] Exponenciação         |
      | [6] Raiz                  |
      | [7] Função afim           |
      | [8] Função quadrática     |
      | [9] Fibonacci             |
      | [10] Fatorial             |
      |                           |
      =============================
''')
opc = int(input("Selecione uma opção: "))
if opc == 1:
    print("SOMA")
    print(" ")
    resp = "s"
    soma = 0
    while resp == "s":
        n = float(input("Digite um número: "))  
        soma += n
        resp = input("Deseja continuar? [s/n] ")  
    print("Soma dos números digitados = ", soma)
elif opc == 2:
    print("SUBTRAÇÃO")
    print(" ")
    resp = "s"
    subt = 0
    while resp == "s":
        n = float(input("Digite um número: "))
        subt = subt - n
        resp = input("Deseja continuar:? [s/n] ")
    print("Subtração dos números digitados = ", subt)
elif opc == 3:
    print("MULTIPLICAÇÃO")
    print(" ")
    resp = "s"
    mult = 1
    while resp == "s":
        n = float(input("Digite um número: "))
        mult *= n
        resp = input("Deseja continuar:? [s/n] ")
    print("Multiplicação dos números digitados = ", mult)