nota1 = float(input("1ª nota: "))
nota2 = float(input("2ª nota: "))
nota3 = float(input("3ª nota: "))
media = (nota1 + nota2 + nota3)/3

if media < 5:
    print(f'''Média: {(media):.2f}
Conceito: Insuficiente''')
elif media >= 5 and media < 7:
    print(f'''Média: {(media):.2f}
Conceito: Regular''')
elif media >= 7 and media < 9:
    print(f'''Média: {(media):.2f}
Conceito: Bom''')
else:
    print(f'''Média: {(media):.2f}
Conceito: Excelente''')