n1 = float(input("Digite o 1º número: "))
n2 = float(input("Digite o 2º número: "))
n3 = float(input("Digite o 3º número: "))

if n1>n2 and n1>n3:
    print(f"{n2} + {n3} = {n2 + n3}")
elif n2>n1 and n2>n3:
    print(f"{n1} + {n3} = {n1 + n3}")
elif n3>n1 and n3>n2:
    print(f"{n1} + {n2} = {n1 + n2}")
else:
    print(f"Os números são todos iguais. Logo: {n1} + {n2} = {n1 + n2}")