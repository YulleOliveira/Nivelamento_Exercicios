l1 = int(input("Lado 1: "))
l2 = int(input("Lado 2: "))
l3 = int(input("Lado 3: "))

if l1 == l2 == l3:
    print("Esta figura é um triângulo do tipo equilátero, pois possui todos os lados iguais.")

elif l1 + l2 > l3 and l1 + l3 > l2 and l2 + l3 > l1:

    if l1 == l2 or l2 == l3 or l1 == l3:
        print("Esta figura é um triângulo do tipo isósceles, pois possui dois lados iguais e um diferente.")
    else:
        print("Esta figura é um triângulo do tipo escaleno, pois possui todos os lados diferentes.")
        if (l1 or l2 or l3)%3 == 0 and (l1 or l2 or l3)%4 == 0 and (l1 or l2 or l3)%5 == 0:
            print("Além disso, este é um triângulo pitagórico!")

else:
    print("Esta figura não é um triângulo.")