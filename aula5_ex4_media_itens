print("Crie uma lista de números: ")
lista = []
n = int(input("Quantos números terá a sua lista? "))
for cont in range (1, n+1):
    item = int(input("Digite um número: "))
    indice = int(input("Escolha o índice: "))
    lista.insert(indice, item)
    print(f"Lista criada até o momento: {lista}")
print(f"Lista final: {lista}")
soma = 0
for i in lista:
    soma += i
media = soma/n
print(f"Média dos números da lista: {media}")